<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <AssemblyName>ProxyPartner</AssemblyName>
    <ApplicationManifest>../../../build/DesktopBaseline/app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Win32" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <ProjectReference Include="../../../src/ProxyPartnerLite/Desktop/ProxyPartnerLite.Desktop.csproj" />
    <Compile Include="../BaselineSource.cs" Link="BaselineSource.cs" />
  </ItemGroup>
</Project>
