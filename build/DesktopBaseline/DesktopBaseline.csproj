<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <AssemblyName>ProxyPartner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ProxyPartner.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Update="TargetIcons\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RegionSize" Value="1048576" />
    <PackageReference Include="QuickProxyNet" Version="[5.0.0]" />
    <PackageReference Include="YamlDotNet" Version="[16.3.0]" />
    <ProjectReference Include="../../src/ProxyPartnerLite/Desktop/ProxyPartnerLite.Desktop.csproj" />
    <ProjectReference Include="../../src/ProxyPartnerLite/Host/ProxyPartnerLite.Host.csproj" />
    <Compile Include="../../tests/ui/BaselineSource.cs" Link="BaselineSource.cs" />
  </ItemGroup>
</Project>
