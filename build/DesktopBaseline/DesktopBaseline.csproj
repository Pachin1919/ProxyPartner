<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <AssemblyName>ProxyPartner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ProxyPartner.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ProxyPartnerLite/Desktop/ProxyPartnerLite.Desktop.csproj" />
    <ProjectReference Include="../../src/ProxyPartnerLite/Host/ProxyPartnerLite.Host.csproj" />
    <Compile Include="../../tests/ui/BaselineSource.cs" Link="BaselineSource.cs" />
  </ItemGroup>
</Project>
